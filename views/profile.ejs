<!--This is for the profile page (/profile)-->
<!--Assuming I'm passed a UserEntry called user and a list of Score called scores-->


<%- include('partials/header') %>
    <!-- import { toggleTheme } from "../theme.js"; -->
    

        <header class = "pageTitle">
            Hey <%= user.username %>!
        </header>

        <div style="display:flex; margin:20px; gap:20px;">
            <!--Has current profile photo and a button to upload a new one-->
            <div style="flex:2;">
                <div class="center">
                    <img class="profilePicture" src="<%= locals.profilePicSrc || '/images/Profile.png' %>" alt="Profile">
                </div>
                <br>
                <div class="center">
                    <button id="photoUpload" class="fancyButton">
                        Upload new photo
                    </button>
                </div>
                    <form id="photoForm" action="/profile/photo" method="POST" enctype="multipart/form-data">
                    <input type="file" id="photoUploadInput" name="photo" accept="image/*" style="display:none;">
                </form>
            </div>

            <div style="flex:4;">
                <!-- Stats from quiz scores -->
                    <table class="statsTable">
                        <thead>
                            <tr>
                                <th colspan="3" style="padding:5px;">Overall Stats</th>
                            </tr>
                            <tr>
                                <th style="padding:5px;">City</th>
                                <th style="padding:5px;">Questions Correct</th>
                                <th style="padding:5px;">Score</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for(let s of scores) {%>
                            <tr>
                                <td style="padding:5px; text-align: center;"><%=s.cityName%></td>
                                <td style="padding:5px; text-align: center;"><%=s.correctCount%></td>
                                <td style="padding:5px; text-align: center;"><%=s.score%> pts</td>
                            </tr>
                            <% } %>
                        </tbody>
                    </table>
                    <!--Settings:-->
                <p>
                    <br><br><br><br><br><br><br><br><br>
                    Settings:<br>
                    <!--Button to toggle account from light to dark mode-->
                    <!-- button logic is within theme.js -->
                    <button id="themeToggle" class="fancyButton" style="margin:10px;">
                        Toggle Light/Dark Mode
                    </button>
                    <br>
                    <!--Button to toggle account from public to private-->
                    <button class="fancyButton" style="margin:10px;">
                        Toggle Privacy On/Off
                    </button>
                    <br>
                    <!-- Button to delete account (Now working)-->
                    <form action="/deleteUser" method="POST" style="margin:10px;"
                        onsubmit="return confirm('Are you sure you want to delete your account?');">
                        <button type="submit" class="deleteButton">
                            Delete Account
                        </button>
                    </form>

                    <br>

                    <!--Logout button-->
                    <form action="/logout" method="POST" style="margin-top:10px;">
                        <button type="submit" class="fancyButton">
                            Logout
                        </button>
                    </form>
                </p>
            </div>
        </div>
<!--Script for detecting and reacting to clicking the "Upload photo" button-->
<script>
  document.getElementById('photoUpload').addEventListener('click', function() {
    document.getElementById('photoUploadInput').click();
  });
  document.getElementById('photoUploadInput').addEventListener('change', function() {
    document.getElementById('photoForm').submit();
  });
</script>
<!--Script to import theme.js for toggling light/dark mode on click-->
<script src="/js/theme.js"/>

<%- include('partials/footer') %>
